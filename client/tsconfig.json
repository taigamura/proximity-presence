{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "react-native",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/domain/*"],
      "@store/*": ["src/store/*"],
      "@nav/*": ["src/nav/*"],
      "@ui/*": ["src/ui/*"],
      "@screens/*": ["src/screens/*"],
      "@theme/*": ["src/theme/*"],
      "@i18n/*": ["src/i18n/*"],
      "@platform/*": ["src/platform/*"]
    }
  },
  "include": ["src", "App.tsx"],
  "exclude": ["node_modules", "babel.config.js"]
}
